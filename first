    "#!/usr/bin/env python3\n",
    "\"\"\"\n",
    "validate_ground_truth.py  (v2 - รองรับคำศัพท์บัญชีที่ต่างกันระหว่างบริษัท)\n",
    "\n",
    "ใช้งาน:\n",
    "    python validate_ground_truth.py tech-01.csv [account_aliases.csv]\n",
    "\n",
    "สิ่งที่เปลี่ยนจาก v1:\n",
    "    v1 ค้นหาชื่อรายการแบบตรงตัว ทำให้ IIG ที่ใช้คำว่า \"รวมส่วนของเจ้าของ\"\n",
    "    แทน \"รวมส่วนของผู้ถือหุ้น\" ถูกข้ามการตรวจไป\n",
    "    v2 แปลงชื่อรายการเป็นรหัส concept ผ่านตารางเทียบคำก่อน แล้วค่อยตรวจ\n",
    "\n",
    "    ***ห้ามแก้ ground truth ให้ตรงกับโค้ด*** ground truth ต้องบันทึกสิ่งที่\n",
    "    เอกสารเขียนจริง ถ้าคำไม่ตรง ให้เพิ่มบรรทัดใหม่ใน account_aliases.csv แทน\n",
    "\"\"\"\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "COLS = [\"con_cur\", \"con_prev\", \"sep_cur\", \"sep_prev\"]\n",
    "\n",
    "ALL_TRAPS = {\"normal\", \"parentheses\", \"dash_empty\", \"subtotal\", \"note_col\",\n",
    "             \"long_name\", \"decimal\", \"small_num\", \"long_num\", \"thai_digit\"}\n",
    "\n",
    "EQUATIONS = [\n",
    "    (\"สินทรัพย์รวม\",\n",
    "     [\"TOTAL_CURRENT_ASSETS\", \"TOTAL_NONCURRENT_ASSETS\"], \"TOTAL_ASSETS\"),\n",
    "    (\"งบดุลสมดุล\",\n",
    "     [\"TOTAL_LIABILITIES\", \"TOTAL_EQUITY\"], \"TOTAL_LIAB_EQUITY\"),\n",
    "]\n",
    "\n",
    "\n",
    "def norm(s):\n",
    "    return \" \".join(str(s).split())\n",
    "\n",
    "\n",
    "def load_aliases(path):\n",
    "    if not Path(path).exists():\n",
    "        print(f\"!! ไม่พบไฟล์ {path} จะตรวจแบบตรงตัวเท่านั้น\\n\")\n",
    "        return {}\n",
    "    a = pd.read_csv(path, encoding=\"utf-8-sig\")\n",
    "    return {norm(r.alias): norm(r.concept) for r in a.itertuples()}\n",
    "\n",
    "\n",
    "def main():\n",
    "    # แก้ไข Path ให้ตรงกับที่คุณอัปโหลดขึ้น Kaggle ครับ\n",
    "    gt_path = \"/kaggle/input/datasets/switchonchannel/ground-truth-financial/ground truth Financial/tech-01.csv\" \n",
    "    \n",
    "    # ถ้าอัปโหลดไฟล์ account_aliases.csv ขึ้น Kaggle แล้ว ให้แก้ Path ตรงนี้ด้วย\n",
    "    alias_path = \"/kaggle/input/datasets/switchonchannel/ground-truth-financial/ground truth Financial/account_aliases.csv\"\n",
    "\n",
    "    df = pd.read_csv(gt_path, encoding=\"utf-8-sig\")\n",
    "    df.columns = [c.strip() for c in df.columns]\n",
    "    aliases = load_aliases(alias_path)\n",
    "    df[\"concept\"] = df[\"item\"].map(lambda x: aliases.get(norm(x)))\n",
    "\n",
    "    print(f\"แถวทั้งหมด {len(df)} | บริษัท {df.company.nunique()}: \"\n",
    "          f\"{list(df.company.unique())}\")\n",
    "    print(f\"ค่าที่กรอกจริง {int(df[COLS].notna().sum().sum())} จาก {len(df)*4} ช่อง\")\n",
    "    if \"unit\" in df.columns:\n",
    "        u = df.groupby(\"company\")[\"unit\"].agg(lambda s: s.unique()[0])\n",
    "        print(f\"หน่วย: {dict(u)}\")\n",
    "    print()\n",
    "\n",
    "    print(\"=== ความครอบคลุมกับดัก ===\")\n",
    "    print(df.pivot_table(index=\"trap\", columns=\"company\", values=\"item\",\n",
    "                         aggfunc=\"count\", fill_value=0).to_string())\n",
    "    miss = ALL_TRAPS - set(df.trap.unique())\n",
    "    print(f\"\\nกับดักที่ยังไม่มีเลย: {sorted(miss) if miss else 'ครบ'}\\n\")\n",
    "\n",
    "    print(\"=== ตรวจเลขคณิต (ผ่าน concept) ===\")\n",
    "    lookup = {}\n",
    "    for r in df.itertuples():\n",
    "        if r.concept:\n",
    "            for c in COLS:\n",
    "                v = getattr(r, c)\n",
    "                if pd.notna(v):\n",
    "                    lookup[(r.company, r.concept, c)] = float(v)\n",
    "\n",
    "    ok = bad = skip = 0\n",
    "    gaps = []\n",
    "    for comp in df.company.unique():\n",
    "        for col in COLS:\n",
    "            for name, parts, total in EQUATIONS:\n",
    "                pv = [lookup.get((comp, p, col)) for p in parts]\n",
    "                tv = lookup.get((comp, total, col))\n",
    "                if tv is None or any(v is None for v in pv):\n",
    "                    skip += 1\n",
    "                    absent = [p for p, v in zip(parts, pv) if v is None]\n",
    "                    if tv is None:\n",
    "                        absent.append(total)\n",
    "                    gaps.append((comp, tuple(absent)))\n",
    "                    continue\n",
    "                if abs(sum(pv) - tv) < 1:\n",
    "                    ok += 1\n",
    "                else:\n",
    "                    bad += 1\n",
    "                    print(f\"  x {comp} [{col}] {name}: {sum(pv):,.0f} != {tv:,.0f}\")\n",
    "    print(f\"  ผ่าน {ok} | ไม่ผ่าน {bad} | ข้าม {skip}\")\n",
    "\n",
    "    if gaps:\n",
    "        print(\"\\n  สาเหตุที่ข้าม:\")\n",
    "        for comp, absent in sorted(set(gaps)):\n",
    "            print(f\"    {comp}: ขาด concept {list(absent)}\")\n",
    "\n",
    "    unmapped = df[df.concept.isna()]\n",
    "    if len(unmapped):\n",
    "        print(f\"\\n=== รายการที่ยังไม่มีใน alias map ({len(unmapped)} แถว) ===\")\n",
    "        print(\"  (ไม่ใช่ข้อผิดพลาด แค่ยังไม่ถูกใช้ตรวจเลขคณิต)\")\n",
    "        for it in unmapped[\"item\"].unique()[:12]:\n",
    "            print(f\"    - {it}\")\n",
    "        n = unmapped[\"item\"].nunique()\n",
    "        if n > 12:\n",
    "            print(f\"    ... อีก {n-12} รายการ\")\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
