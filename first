    "#!/usr/bin/env python3\n",
    "\"\"\"\n",
    "inspect_risk.py\n",
    "เจาะดูว่าไฟล์ที่ถูกจัดเป็น TEXT_RISK มีปัญหาอะไรกันแน่\n",
    "\n",
    "ใช้งาน:\n",
    "    python inspect_risk.py path/to/file.pdf\n",
    "    python inspect_risk.py path/to/file.pdf --pages 1-5\n",
    "\n",
    "สาเหตุที่พบบ่อย 4 แบบ และวิธีรับมือ:\n",
    "\n",
    "  A) ตัวเลขถูกแทรกช่องว่าง   \"7 04,121\"\n",
    "     -> ลอง pdftotext แบบไม่ใส่ -layout, หรือใช้ pdfplumber ดึงทีละ word\n",
    "        แล้วเชื่อมด้วยพิกัด x\n",
    "\n",
    "  B) หน้าแรกเป็นปกหรือหน้ารายงานผู้สอบบัญชี ไม่มีตาราง\n",
    "     -> ไม่ใช่ปัญหา แค่ตรวจผิดหน้า ให้ระบุหน้าที่เป็นงบจริง\n",
    "\n",
    "  C) ตัวเลขติดกับข้อความไทยโดยไม่มีช่องว่าง  \"คงเหลือ37,379\"\n",
    "     -> แก้ด้วย regex แทรกช่องว่างก่อนตัวเลข\n",
    "\n",
    "  D) ตารางเป็นภาพฝังในหน้าที่มี text layer (hybrid)\n",
    "     -> ต้อง OCR เฉพาะหน้านั้น\n",
    "\"\"\"\n",
    "!apt-get update\n",
    "!apt-get install -y poppler-utils\n",
    "import re\n",
    "import subprocess\n",
    "import sys\n",
    "from pathlib import Path\n",
    " \n",
    "NUM = re.compile(r\"\\d{1,3}(?:,\\d{3})+(?:\\.\\d+)?\")\n",
    "THAI_CONS = r\"\\u0e01-\\u0e2e\"\n",
    "THAI_ANY = r\"\\u0e00-\\u0e7f\"\n",
    " \n",
    "# เลขที่ถูกตัดหัวจริง ๆ ต้องมี \"ตัวเลขนำ\" ที่ไม่ใช่คอลัมน์หมายเหตุ\n",
    "# คอลัมน์หมายเหตุ = เลขเดี่ยว 1-2 หลัก หรือ n.n ที่มีช่องว่างกว้างล้อมรอบ\n",
    "NOTE_COL = re.compile(r\"\\s{2,}\\d{1,2}(?:\\.\\d)?\\s{2,}\")\n",
    "# ตัวเลขถูกตัดจริง: ช่องว่างแคบ (1 ช่อง) คั่นกลางกลุ่มตัวเลข\n",
    "TRUE_SPLIT = re.compile(r\"(?<![\\d,\\s])\\d\\s\\d{2},\\d{3}\")\n",
    "# ตัวเลขติดอักษรไทย\n",
    "GLUED = re.compile(rf\"[{THAI_ANY}]\\d{{1,3}},\\d{{3}}\")\n",
    "# วรรณยุกต์กลายเป็นเลข: พยัญชนะไทย + ตัวเลขเดี่ยว + ขอบคำ\n",
    "MARK_AS_DIGIT = re.compile(rf\"[{THAI_CONS}]\\d(?![\\d,])\")\n",
    " \n",
    " \n",
    "def run(path, first=None, last=None):\n",
    "    cmd = [\"pdftotext\", \"-layout\"]\n",
    "    if first:\n",
    "        cmd += [\"-f\", str(first), \"-l\", str(last)]\n",
    "    cmd += [str(path), \"-\"]\n",
    "    return subprocess.run(cmd, capture_output=True, text=True).stdout\n",
    " \n",
    " \n",
    "def find_statement_pages(path, upto=12):\n",
    "    pages = []\n",
    "    for p in range(1, upto + 1):\n",
    "        t = run(path, p, p)\n",
    "        if not t.strip():\n",
    "            continue\n",
    "        if len(NUM.findall(t)) >= 20:\n",
    "            pages.append(p)\n",
    "    return pages\n",
    " \n",
    " \n",
    "def analyse(path, page):\n",
    "    t = run(path, page, page)\n",
    "    lines = t.split(\"\\n\")\n",
    " \n",
    "    real_splits, note_cols = [], 0\n",
    "    for ln in lines:\n",
    "        if NOTE_COL.search(ln):\n",
    "            note_cols += 1\n",
    "        if TRUE_SPLIT.search(ln):\n",
    "            real_splits.append(ln.strip())\n",
    " \n",
    "    glued = GLUED.findall(t)\n",
    "    marks = MARK_AS_DIGIT.findall(t)\n",
    " \n",
    "    print(f\"    ตัวเลขทั้งหมด            : {len(NUM.findall(t))}\")\n",
    "    print(f\"    บรรทัดที่มีคอลัมน์หมายเหตุ : {note_cols}  (ปกติ ไม่ใช่ปัญหา)\")\n",
    "    print(f\"    ตัวเลขถูกตัดจริง          : {len(real_splits)}\")\n",
    "    print(f\"    ตัวเลขติดอักษรไทย         : {len(glued)}\")\n",
    "    print(f\"    วรรณยุกต์กลายเป็นเลข      : {len(marks)}\")\n",
    " \n",
    "    if real_splits:\n",
    "        print(\"\\n    ตัวอย่างตัวเลขที่ถูกตัด:\")\n",
    "        for ln in real_splits[:3]:\n",
    "            print(f\"      | {ln[:84]}\")\n",
    "        print(\"    วิธีแก้: ใช้ pdfplumber extract_words() แล้วเชื่อมด้วยพิกัด x\")\n",
    "        print(\"             อย่าถอด -layout ออก จะเสียการเรียงคอลัมน์\")\n",
    " \n",
    "    if marks:\n",
    "        print(f\"\\n    ตัวอย่างวรรณยุกต์ที่เพี้ยนเป็นเลข: {marks[:6]}\")\n",
    "        print(\"    ผลกระทบ: ฉีดตัวเลขปลอมเข้าไปในข้อความ\")\n",
    "        print(\"    วิธีแก้: ตัดตัวเลขที่ติดพยัญชนะไทยทิ้งก่อน parse\")\n",
    "        print(\"             re.sub(r'(?<=[\\\\u0e01-\\\\u0e2e])\\\\d(?![\\\\d,])', '', text)\")\n",
    " \n",
    "    if not real_splits and not glued and not marks:\n",
    "        print(\"\\n    ไม่พบปัญหาในหน้านี้ ใช้ pdftotext -layout ได้เลย\")\n",
    "\n",
    "\n",
    "\n",
    "def main():\n",
    "    # 1. ระบุ Path ของโฟลเดอร์ Dataset บน Kaggle (แก้ไขให้ตรงกับของคุณ)\n",
    "    base_dir = Path(\"/kaggle/input/datasets/switchonchannel/financial-data-v2/Financial_DATA\") \n",
    "    \n",
    "    # 2. ระบุชื่อไฟล์ที่ติดสถานะ TEXT_RISK ที่เราต้องการเจาะดูปัญหา\n",
    "    target_files = [\n",
    "        \"20260513-bbik-fs-1q2026-th.pdf\",\n",
    "        \"20260514-sat-fs-1q2026-th.pdf\",\n",
    "        \"1q26-financial-statement-note-th_SCB.pdf\"\n",
    "    ]\n",
    "    \n",
    "    # ถ้าต้องการรันตรวจ \"ทุกไฟล์\" ในโฟลเดอร์ ให้เอาเครื่องหมาย # ออกที่บรรทัดล่าง แล้วลบ/คอมเมนต์ 2 บรรทัดบนทิ้ง\n",
    "    # files = sorted(base_dir.glob(\"*.pdf\")) \n",
    "    \n",
    "    # นำชื่อไฟล์มารวมกับ Path\n",
    "    files = [base_dir / f for f in target_files]\n",
    "    \n",
    "    for f in files:\n",
    "        if not f.exists():\n",
    "            print(f\"\\n[Error] ไม่พบไฟล์: {f}\")\n",
    "            continue\n",
    "            \n",
    "        print(f\"\\n{'=' * 62}\\n{f.name}\\n{'=' * 62}\")\n",
    "        pages = find_statement_pages(f)\n",
    "        if not pages:\n",
    "            print(\"  ไม่พบหน้าตารางงบการเงินใน 12 หน้าแรก (อาจต้อง OCR หรือเป็นหน้าปก)\")\n",
    "            continue\n",
    "        print(f\"  หน้างบการเงิน: {pages}\")\n",
    "        print(f\"\\n  --- หน้า {pages[0]} ---\")\n",
    "        analyse(f, pages[0])\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  },
