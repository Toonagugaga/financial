    "\n",
    "import re\n",
    "import sys\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "COLS = [\"con_cur\", \"con_prev\", \"sep_cur\", \"sep_prev\"]\n",
    "THAI_CONS = re.compile(r\"[\\u0e01-\\u0e2e]\")\n",
    "\n",
    "\n",
    "def skeleton(s):\n",
    "    return \"\".join(THAI_CONS.findall(str(s)))\n",
    "\n",
    "\n",
    "def main():\n",
    "    # กำหนด Path ของไฟล์ทั้ง 3 ตัว\n",
    "    gt_path = \"/kaggle/input/datasets/switchonchannel/ground-truth-financial/ground truth Financial/tech-01.csv\" # Ground Truth ของคุณ\n",
    "    ex_path = \"/kaggle/working/extracted.csv\" # ไฟล์ผลลัพธ์จากโค้ดเมื่อกี้\n",
    "    alias_path = \"/kaggle/input/datasets/switchonchannel/ground-truth-financial/ground truth Financial/account_aliases.csv\" # ไฟล์พจนานุกรม\n",
    "    \n",
    "    gt = pd.read_csv(gt_path, encoding=\"utf-8-sig\")\n",
    "    ex = pd.read_csv(ex_path, encoding=\"utf-8-sig\")\n",
    "\n",
    "    gt.columns = [c.strip() for c in gt.columns]\n",
    "    al = pd.read_csv(alias_path, encoding=\"utf-8-sig\")\n",
    "    a2c = {skeleton(r.alias): r.concept for r in al.itertuples()}\n",
    "    gt[\"concept\"] = gt[\"item\"].map(lambda x: a2c.get(skeleton(x)))\n",
    "\n",
    "    unmapped = gt[gt.concept.isna()]\n",
    "    print(f\"ground truth {len(gt)} แถว | map เป็น concept ได้ {len(gt)-len(unmapped)}\")\n",
    "    if len(unmapped):\n",
    "        print(f\"  ไม่ถูกประเมิน {len(unmapped)} แถว (ยังไม่มีใน alias map)\")\n",
    "    gt = gt.dropna(subset=[\"concept\"])\n",
    "\n",
    "    # ผลสกัด: ถ้ามี concept ซ้ำ เลือกแถวที่ match_score สูงสุด\n",
    "    if \"match_score\" in ex.columns:\n",
    "        ex = ex.sort_values(\"match_score\", ascending=False)\n",
    "    ex = ex.dropna(subset=[\"concept\"]).drop_duplicates([\"company\", \"concept\"])\n",
    "    lut = {(r.company, r.concept): r for r in ex.itertuples()}\n",
    "\n",
    "    recs = []\n",
    "    for r in gt.itertuples():\n",
    "        got = lut.get((r.company, r.concept))\n",
    "        for col in COLS:\n",
    "            want = getattr(r, col)\n",
    "            have = getattr(got, col) if got is not None else None\n",
    "            want_na, have_na = pd.isna(want), (have is None or pd.isna(have))\n",
    "            if want_na and have_na:\n",
    "                status = \"ok_empty\"          # ทั้งคู่ว่าง = ถูก\n",
    "            elif want_na != have_na:\n",
    "                status = \"miss\" if got is None else \"wrong_empty\"\n",
    "            elif abs(float(want) - float(have)) < 0.005:\n",
    "                status = \"ok\"\n",
    "            else:\n",
    "                status = \"wrong\"\n",
    "            recs.append({\"company\": r.company, \"concept\": r.concept,\n",
    "                         \"trap\": r.trap, \"col\": col, \"status\": status,\n",
    "                         \"want\": want, \"have\": have})\n",
    "\n",
    "    d = pd.DataFrame(recs)\n",
    "    good = d.status.isin([\"ok\", \"ok_empty\"]).sum()\n",
    "    print(f\"\\n=== ภาพรวม ===\")\n",
    "    print(f\"  ช่องที่เทียบ {len(d)} | ถูก {good} | แม่นยำ {good/len(d)*100:.1f}%\")\n",
    "    print(d.status.value_counts().to_string())\n",
    "\n",
    "    print(f\"\\n=== แยกตาม trap ===\")\n",
    "    t = d.assign(ok=d.status.isin([\"ok\", \"ok_empty\"])).groupby(\"trap\")[\"ok\"]\n",
    "    tt = t.agg([\"sum\", \"count\"])\n",
    "    tt[\"pct\"] = (tt[\"sum\"] / tt[\"count\"] * 100).round(1)\n",
    "    print(tt.sort_values(\"pct\").to_string())\n",
    "\n",
    "    print(f\"\\n=== แยกตามบริษัท ===\")\n",
    "    c = d.assign(ok=d.status.isin([\"ok\", \"ok_empty\"])).groupby(\"company\")[\"ok\"]\n",
    "    cc = c.agg([\"sum\", \"count\"])\n",
    "    cc[\"pct\"] = (cc[\"sum\"] / cc[\"count\"] * 100).round(1)\n",
    "    print(cc.sort_values(\"pct\").to_string())\n",
    "\n",
    "    bad = d[~d.status.isin([\"ok\", \"ok_empty\"])]\n",
    "    if len(bad):\n",
    "        print(f\"\\n=== รายการที่ผิด ({len(bad)} ช่อง, แสดง 20 แรก) ===\")\n",
    "        print(bad.head(20)[[\"company\", \"concept\", \"col\", \"trap\",\n",
    "                            \"want\", \"have\", \"status\"]].to_string(index=False))\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
