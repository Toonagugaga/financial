    "import argparse\n",
    "import re\n",
    "import subprocess\n",
    "import sys\n",
    "from collections import Counter\n",
    "from difflib import SequenceMatcher\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "THAI_CONS = re.compile(r\"[\\u0e01-\\u0e2e]\")\n",
    "# token ที่เป็นค่าตัวเลข หรือขีดกลางที่แปลว่าไม่มีค่า\n",
    "TOKEN = re.compile(r\"\\(?-?[\\d,]+\\.?\\d*\\)?|(?<![\\u0e00-\\u0e7f\\w])-(?![\\d\\u0e00-\\u0e7f])\")\n",
    "UNIT_PAT = re.compile(r\"หน\\s*่?\\s*วย\\s*[:：]?\\s*(พัน|ล้าน)?\\s*บาท\")\n",
    "\n",
    "\n",
    "# ---------- การจัดการข้อความไทย ----------\n",
    "\n",
    "def skeleton(s: str) -> str:\n",
    "    \"\"\"เหลือเฉพาะพยัญชนะไทย ใช้เทียบชื่อรายการที่สกัดมาเพี้ยน\"\"\"\n",
    "    return \"\".join(THAI_CONS.findall(str(s)))\n",
    "\n",
    "\n",
    "def clean_label(s: str) -> str:\n",
    "    \"\"\"เก็บข้อความดิบไว้อ่าน แต่ตัดตัวเลขที่ติดพยัญชนะ (วรรณยุกต์กลายเป็นเลข)\"\"\"\n",
    "    s = re.sub(r\"(?<=[\\u0e01-\\u0e2e])[0-9](?![\\d,])\", \"\", s)\n",
    "    return \" \".join(s.split())\n",
    "\n",
    "\n",
    "# ---------- การอ่าน PDF ----------\n",
    "\n",
    "def page_text(pdf: Path, page: int) -> str:\n",
    "    return subprocess.run(\n",
    "        [\"pdftotext\", \"-layout\", \"-f\", str(page), \"-l\", str(page), str(pdf), \"-\"],\n",
    "        capture_output=True, text=True).stdout\n",
    "\n",
    "\n",
    "def n_pages(pdf: Path) -> int:\n",
    "    out = subprocess.run([\"pdfinfo\", str(pdf)], capture_output=True, text=True).stdout\n",
    "    m = re.search(r\"Pages:\\s+(\\d+)\", out)\n",
    "    return int(m.group(1)) if m else 0\n",
    "\n",
    "\n",
    "def detect_unit(text: str) -> str:\n",
    "    m = UNIT_PAT.search(text.replace(\"\\u0e4d\", \"\"))\n",
    "    if not m:\n",
    "        return \"unknown\"\n",
    "    return {\"พัน\": \"thousand\", \"ล้าน\": \"million\", None: \"baht\"}[m.group(1)]\n",
    "\n",
    "\n",
    "def is_balance_sheet_page(text: str) -> bool:\n",
    "    sk = skeleton(text)\n",
    "    has_table = len(re.findall(r\"\\d{1,3}(?:,\\d{3})+\", text)) >= 15\n",
    "    # โครงของ \"สินทรัพย์\" คือ สนทรพย\n",
    "    return has_table and (\"สนทรพย\" in sk or \"หนสน\" in sk)\n",
    "\n",
    "\n",
    "# ---------- การแยกคอลัมน์ ----------\n",
    "\n",
    "def to_number(tok: str):\n",
    "    tok = tok.strip()\n",
    "    if tok in {\"-\", \"\"}:\n",
    "        return None\n",
    "    neg = tok.startswith(\"(\") and tok.endswith(\")\")\n",
    "    body = tok.strip(\"()\").replace(\",\", \"\")\n",
    "    if not re.fullmatch(r\"-?\\d+(\\.\\d+)?\", body):\n",
    "        return None\n",
    "    v = float(body)\n",
    "    return -v if neg else v\n",
    "\n",
    "\n",
    "def find_columns(lines):\n",
    "    \"\"\"หาตำแหน่ง x ของคอลัมน์ตัวเลข จากจุดสิ้นสุดของ token (ตัวเลขชิดขวา)\"\"\"\n",
    "    ends = Counter()\n",
    "    for ln in lines:\n",
    "        for m in TOKEN.finditer(ln):\n",
    "            if to_number(m.group()) is not None or m.group().strip() == \"-\":\n",
    "                ends[m.end()] += 1\n",
    "    if not ends:\n",
    "        return []\n",
    "    # ตัดตำแหน่งที่โผล่ครั้งสองครั้งทิ้งก่อน มิฉะนั้นจะจับกลุ่มปลอมขึ้นมา\n",
    "    ends = {p: c for p, c in ends.items() if c >= 3}\n",
    "    if not ends:\n",
    "        return []\n",
    "    # รวมตำแหน่งที่ห่างกันไม่เกิน 3 ตัวอักษรเป็นคอลัมน์เดียวกัน\n",
    "    groups, cur = [], []\n",
    "    for pos in sorted(ends):\n",
    "        if cur and pos - cur[-1] > 3:\n",
    "            groups.append(cur)\n",
    "            cur = []\n",
    "        cur.append(pos)\n",
    "    groups.append(cur)\n",
    "    # ให้น้ำหนักคอลัมน์ตามความถี่ ใช้ตำแหน่งขวาสุดของกลุ่มเป็นตัวแทน\n",
    "    scored = [(sum(ends[p] for p in g), max(g)) for g in groups]\n",
    "    top = max(s for s, _ in scored)\n",
    "    return sorted(pos for s, pos in scored if s >= top * 0.25)\n",
    "\n",
    "\n",
    "def drop_note_column(cols, lines):\n",
    "    \"\"\"คอลัมน์หมายเหตุ = ซ้ายสุด และค่าส่วนใหญ่เป็นเลขสั้นไม่มีคอมม่า\"\"\"\n",
    "    if len(cols) <= 4:\n",
    "        return cols\n",
    "    first = cols[0]\n",
    "    short = total = 0\n",
    "    for ln in lines:\n",
    "        for m in TOKEN.finditer(ln):\n",
    "            if abs(m.end() - first) <= 3:\n",
    "                total += 1\n",
    "                t = m.group().strip()\n",
    "                if \",\" not in t and len(t.strip(\"()-\")) <= 2:\n",
    "                    short += 1\n",
    "    if total and short / total > 0.6:\n",
    "        cols = cols[1:]\n",
    "    # งบไทยมี 4 คอลัมน์ค่าเสมอ (งบรวม 2 งวด + งบเฉพาะกิจการ 2 งวด)\n",
    "    return cols[-4:]\n",
    "\n",
    "\n",
    "def parse_line(ln, cols):\n",
    "    \"\"\"คืน (label, [ค่า 4 คอลัมน์]) หรือ None ถ้าไม่ใช่บรรทัดข้อมูล\"\"\"\n",
    "    hits = [(m.end(), m.group()) for m in TOKEN.finditer(ln)]\n",
    "    if not hits:\n",
    "        return None\n",
    "    first_start = min(m.start() for m in TOKEN.finditer(ln))\n",
    "    label = clean_label(ln[:first_start])\n",
    "    if len(skeleton(label)) < 3:\n",
    "        return None\n",
    "\n",
    "    vals = [None] * len(cols)\n",
    "    for end, tok in hits:\n",
    "        dists = [abs(end - c) for c in cols]\n",
    "        i = dists.index(min(dists))\n",
    "        if dists[i] <= 4:\n",
    "            vals[i] = to_number(tok)\n",
    "\n",
    "    # กรองแถวหัวตาราง: ค่าทุกช่องเป็นปี พ.ศ. หรือ ค.ศ.\n",
    "    present = [v for v in vals if v is not None]\n",
    "    if present and all(2400 <= v <= 2700 or 1990 <= v <= 2100 for v in present):\n",
    "        return None\n",
    "    return label, vals\n",
    "\n",
    "\n",
    "# ---------- การเทียบกับ alias map ----------\n",
    "\n",
    "def build_matcher(alias_csv):\n",
    "    if not Path(alias_csv).exists():\n",
    "        return {}, []\n",
    "    a = pd.read_csv(alias_csv, encoding=\"utf-8-sig\")\n",
    "    exact = {}\n",
    "    for r in a.itertuples():\n",
    "        exact[skeleton(r.alias)] = r.concept\n",
    "    return exact, list(exact.items())\n",
    "\n",
    "\n",
    "def match_concept(label, exact, pairs, cutoff=0.90):\n",
    "    sk = skeleton(label)\n",
    "    if not sk:\n",
    "        return None, 0.0\n",
    "    if sk in exact:\n",
    "        return exact[sk], 1.0\n",
    "    best, score = None, 0.0\n",
    "    for k, concept in pairs:\n",
    "        r = SequenceMatcher(None, sk, k).ratio()\n",
    "        if r > score:\n",
    "            best, score = concept, r\n",
    "    return (best, score) if score >= cutoff else (None, score)\n",
    "\n",
    "\n",
    "# ---------- main ----------\n",
    "\n",
    "def extract_pdf(pdf: Path, company: str, exact, pairs):\n",
    "    rows = []\n",
    "    total = n_pages(pdf)\n",
    "    for p in range(1, min(total, 12) + 1):\n",
    "        t = page_text(pdf, p)\n",
    "        if not is_balance_sheet_page(t):\n",
    "            continue\n",
    "        unit = detect_unit(t)\n",
    "        lines = t.split(\"\\n\")\n",
    "        cols = find_columns(lines)\n",
    "        if len(cols) < 2:\n",
    "            continue\n",
    "        cols = drop_note_column(cols, lines)\n",
    "        for ln in lines:\n",
    "            parsed = parse_line(ln, cols)\n",
    "            if not parsed:\n",
    "                continue\n",
    "            label, vals = parsed\n",
    "            if all(v is None for v in vals):\n",
    "                continue\n",
    "            concept, score = match_concept(label, exact, pairs)\n",
    "            vals = (vals + [None] * 4)[:4]\n",
    "            rows.append({\n",
    "                \"company\": company, \"unit\": unit, \"page\": p,\n",
    "                \"item_raw\": label, \"concept\": concept,\n",
    "                \"match_score\": round(score, 3),\n",
    "                \"con_cur\": vals[0], \"con_prev\": vals[1],\n",
    "                \"sep_cur\": vals[2], \"sep_prev\": vals[3],\n",
    "            })\n",
    "    return rows\n",
    "\n",
    "\n",
    "def main():\n",
    "    # กำหนด Path ของไฟล์ต่างๆ บน Kaggle\n",
    "    target_dir = \"/kaggle/input/datasets/switchonchannel/financial-data-v2/Financial_DATA\" # 1. โฟลเดอร์เก็บไฟล์ PDF\n",
    "    alias_path = \"/kaggle/input/datasets/switchonchannel/ground-truth-financial/ground truth Financial/account_aliases.csv\" # 2. ไฟล์พจนานุกรมคำศัพท์\n",
    "    out_csv = \"/kaggle/working/extracted.csv\" # 3. ตำแหน่งที่จะเซฟไฟล์ผลลัพธ์ (ให้อยู่ที่ /kaggle/working/)\n",
    "    \n",
    "    exact, pairs = build_matcher(alias_path)\n",
    "    if not exact:\n",
    "        print(f\"!! ไม่พบ {alias_path} จะไม่มีการ map concept\")\n",
    "\n",
    "    tgt = Path(target_dir)\n",
    "    files = sorted(tgt.glob(\"*.pdf\")) if tgt.is_dir() else [tgt]\n",
    "\n",
    "    all_rows = []\n",
    "    for f in files:\n",
    "        # ดึงเฉพาะชื่อบริษัท 4 แห่งที่เราสนใจ เพื่อลดเวลาการรัน (เพิ่มลดได้)\n",
    "        # ถ้าชื่อไฟล์ของคุณไม่มีชื่อบริษัทชัดเจน อาจจะต้องแก้ RegEx หรือตั้งชื่อโฟลเดอร์แยก\n",
    "        comp = re.sub(\n",
    "            r\"(financial_statements_|_fs.*|-fs.*|\\d+|[-_])\", \"\", f.stem, flags=re.I\n",
    "        ).upper()\n",
    "        \n",
    "        # ป้องกันสคริปต์ไปรันไฟล์ที่ไม่เกี่ยว ให้ตรวจจับเฉพาะบริษัทใน Ground Truth\n",
    "        if any(c in comp for c in [\"MFEC\", \"GABLE\", \"BBIK\", \"IIG\"]): \n",
    "            # ถ้าชื่อย่ออยู่ในชื่อไฟล์ ให้ใช้ชื่อย่อนั้นเป็นชื่อบริษัท\n",
    "            final_comp = next((c for c in [\"MFEC\", \"GABLE\", \"BBIK\", \"IIG\"] if c in comp), comp)\n",
    "            \n",
    "            rows = extract_pdf(f, final_comp, exact, pairs)\n",
    "            mapped = sum(1 for r in rows if r[\"concept\"])\n",
    "            print(f\"{f.name:<45} {final_comp:<8} {len(rows):>3} แถว | map ได้ {mapped}\")\n",
    "            all_rows += rows\n",
    "\n",
    "    if not all_rows:\n",
    "        print(\"ไม่พบข้อมูล หรือชื่อไฟล์ไม่ตรงกับบริษัทที่ค้นหา\")\n",
    "        return\n",
    "        \n",
    "    df = pd.DataFrame(all_rows)\n",
    "    df.to_csv(out_csv, index=False, encoding=\"utf-8-sig\")\n",
    "    print(f\"\\nบันทึก {len(df)} แถว -> {out_csv}\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
